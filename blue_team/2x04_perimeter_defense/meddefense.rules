# -------------------------------------------------
# MedDefense custom Suricata rules
# SID range: 9000000
# -------------------------------------------------

# 1A. Medical device TCP traffic to Internet
alert tcp 10.10.4.0/24 any -> $EXTERNAL_NET any (msg:"MEDDEFENSE MEDDEV TCP to Internet"; classtype:policy-violation; sid:9000001; rev:1;)

# 1B. Medical device UDP traffic to Internet except udp/123 NTP
alert udp 10.10.4.0/24 any -> $EXTERNAL_NET !123 (msg:"MEDDEFENSE MEDDEV UDP to Internet except NTP"; classtype:policy-violation; sid:9000007; rev:1;)

# 2. Unauthorized SMB from guest network
alert tcp 10.10.5.0/24 any -> $HOME_NET 445 (msg:"MEDDEFENSE Guest to SMB"; classtype:policy-violation; sid:9000002; rev:1;)

# 3. Large outbound transfer from server network
# 50 MB threshold, single source/destination pair, 300-second alert window
alert tcp 10.10.1.0/24 any -> $EXTERNAL_NET any (msg:"MEDDEFENSE Large Outbound From Server"; flow:established,to_server; stream_size:client,>,52428800; threshold:type limit, track by_both, count 1, seconds 300; classtype:policy-violation; sid:9000003; rev:1;)

# 4. DNS tunneling - leftmost DNS label longer than 50 characters
# dns.query content rule
alert dns $HOME_NET any -> any any (msg:"MEDDEFENSE DNS Tunneling Long Label"; dns.query; content:"."; pcre:"/^[^.]{51,}\./"; classtype:bad-unknown; sid:9000004; rev:1;)

# 5. Clinical workstation accessing unauthorized MySQL database
# Authorized billing database assumed to be 10.10.1.10
alert tcp 10.10.2.0/24 any -> !10.10.1.10 3306 (msg:"MEDDEFENSE Clinical to Unauthorized DB"; classtype:policy-violation; sid:9000005; rev:1;)

# 6. Telnet cleartext access to medical devices
alert tcp any any -> 10.10.4.0/24 23 (msg:"MEDDEFENSE Telnet to MEDDEV"; classtype:policy-violation; sid:9000006; rev:1;)
